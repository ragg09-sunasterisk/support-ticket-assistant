{
  "name": "support-ticket-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Support Ticket Assistant: course project for AI Engineering Upskilling",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test && npm run check:secrets",
    "check:secrets": "node scripts/check-secrets.mjs",
    "ticket": "node src/log-ticket-runs.ts",
    "triage": "node src/triage-one-ticket.ts",
    "golden": "node src/run-golden-set.ts",
    "eval": "node src/run-eval.ts",
    "human-labels": "node src/pick-human-label-cases.ts",
    "grader-check": "node src/grader-check.ts",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "promptfoo": "0.125.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  }
}
