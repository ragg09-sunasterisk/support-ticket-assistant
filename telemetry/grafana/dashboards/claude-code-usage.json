{
  "uid": "claude-code-usage",
  "title": "Claude Code usage (Support Ticket Assistant)",
  "description": "Part 7: tokens by type and estimated cost per Claude Code session, from OpenTelemetry metrics. On a Team seat the dollar figure is an estimate; the real limit is plan usage (/usage).",
  "tags": ["claude-code", "part-07"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Estimated cost, all sessions (USD)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(last_over_time(claude_code_cost_usage_USD_total[$__range]))", "instant": true }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "none" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Tokens by type, all sessions",
      "gridPos": { "x": 6, "y": 0, "w": 18, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (type) (last_over_time(claude_code_token_usage_tokens_total[$__range]))", "instant": true, "legendFormat": "{{type}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "none", "textMode": "value_and_name" }
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Tokens by type, per session",
      "description": "input excludes cache tokens; cacheRead and cacheCreation are counted on their own.",
      "gridPos": { "x": 0, "y": 5, "w": 14, "h": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (session_id, type) (last_over_time(claude_code_token_usage_tokens_total[$__range]))", "instant": true, "legendFormat": "{{session_id}} · {{type}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "options": { "orientation": "horizontal", "displayMode": "basic", "showUnfilled": true, "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Estimated cost per session (USD)",
      "description": "From claude_code.cost.usage. An estimate at API prices, not a bill: a Team seat is limited by plan usage (/usage).",
      "gridPos": { "x": 14, "y": 5, "w": 10, "h": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (session_id) (last_over_time(claude_code_cost_usage_USD_total[$__range]))", "instant": true, "legendFormat": "{{session_id}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 3, "min": 0 }, "overrides": [] },
      "options": { "orientation": "horizontal", "displayMode": "basic", "showUnfilled": true, "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Tokens per minute by type",
      "gridPos": { "x": 0, "y": 17, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (type) (increase(claude_code_token_usage_tokens_total[1m]))", "legendFormat": "{{type}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    }
  ]
}
